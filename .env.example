# ============================================
# Tony & Rea Configuration
# ============================================

# OpenAI API Configuration
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your-key-here

# Model to use (gpt-4o-mini recommended for cost efficiency)
# Options: gpt-4o-mini (cheapest), gpt-4o (balanced), gpt-4 (expensive legacy)
OPENAI_MODEL=gpt-4o-mini

# ============================================
# Server Configuration
# ============================================
PORT=3001
NODE_ENV=development

# ============================================
# Data Storage
# ============================================
# Directory for storing projects, KB entries, and threads
DATA_DIR=./data
