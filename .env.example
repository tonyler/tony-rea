# ============================================
# Tony & Rea Configuration
# ============================================

# ============================================
# Server Configuration
# ============================================
PORT=3001
NODE_ENV=development

# ============================================
# Data Storage
# ============================================
# Directory for storing projects, KB entries, and threads
DATA_DIR=./data

# ============================================
# Discord OAuth (Required for authentication)
# ============================================
# Create an app at: https://discord.com/developers/applications
# Enable OAuth2 and add the callback URL
DISCORD_CLIENT_ID=your-client-id
DISCORD_CLIENT_SECRET=your-client-secret
DISCORD_REDIRECT_URI=http://localhost:3001/api/auth/callback

# ============================================
# Multi-LLM Providers (Required for Articles)
# ============================================

# Perplexity (REQUIRED) - Gateway for most models
# https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-xxx

# Anthropic Claude (REQUIRED) - For article generation
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxx

# xAI Grok (Optional) - Only needed for X/Twitter search
# https://x.ai/
XAI_API_KEY=xai-xxx

# OpenAI (Optional) - Fallback only
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxx

# Google Gemini (Optional) - Fallback only
# https://ai.google.dev/
GOOGLE_API_KEY=xxx

# ============================================
# Article Generation Config
# ============================================
# Maximum budget per article generation ($ - hard cap at $0.20)
MAX_ARTICLE_BUDGET=0.10
